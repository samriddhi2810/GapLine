SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

DB_NAME=gapline
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
TEST_DB_NAME=test_gapline

# Railway MySQL also exposes these names automatically when variables are linked.
# The app uses them as fallbacks if DB_* variables are not set.
MYSQLDATABASE=gapline
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLHOST=127.0.0.1
MYSQLPORT=3306

# Optional local-only fallback for development/testing when MySQL is unavailable.
GAPLINE_SQLITE=False
